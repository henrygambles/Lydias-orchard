  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrygambles/Lydias-orchard.git"
  },
  "homepage": "https://github.com/henrygambles/Lydias-orchard#readme",
  "bugs": {
    "url": "https://github.com/henrygambles/Lydias-orchard/issues"
  },
  "publishConfig": {
    "access": "public"
  }
